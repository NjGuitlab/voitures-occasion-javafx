<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cours.controller.MainController">
   <top>
      <VBox alignment="CENTER" spacing="10.0" styleClass="top-bar-container" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="main-title" text="CarFinder" />
            <HBox alignment="CENTER" spacing="18.0">
               <children>
               <VBox spacing="4.0">
               <children>
                  <Label styleClass="filter-label" text="Recherche :" />
                  <TextField fx:id="champRecherche" prefWidth="170.0" promptText="Mot-clé, modèle, ville..." />
               </children>
               </VBox>
                  <VBox prefWidth="130.0" spacing="2.0">
                     <children>
                        <Label styleClass="filter-label" text="Kilométrage maximum :" />
                        <Slider fx:id="sliderKilometrage" />
                        <Label fx:id="labelSliderKilometrage" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="slider-value-label" />
                     </children>
                  </VBox>
                  <VBox prefWidth="110.0" spacing="2.0">
                     <children>
                        <Label styleClass="filter-label" text="Année minimum :" />
                        <Slider fx:id="sliderAnneeMin" />
                        <Label fx:id="labelSliderAnneeMin" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="slider-value-label" />
                     </children>
                  </VBox>
                  <VBox prefWidth="110.0" spacing="2.0">
                     <children>
                        <Label styleClass="filter-label" text="Année maximum :" />
                        <Slider fx:id="sliderAnneeMax" />
                        <Label fx:id="labelSliderAnneeMax" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="slider-value-label" />
                     </children>
                  </VBox>
                  <VBox prefWidth="120.0" spacing="2.0">
                     <children>
                        <Label styleClass="filter-label" text="Prix maximum :" />
                        <Slider fx:id="sliderPrix" />
                        <Label fx:id="labelSliderPrix" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="slider-value-label" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="filter-label" text="Type de carburant : " />
                        <ComboBox fx:id="comboCarburant" prefWidth="120.0" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox prefHeight="500.0" prefWidth="588.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
               <children>
                  <Label styleClass="section-title" text="Véhicules disponibles">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Label>
                  <Region prefHeight="35.0" prefWidth="338.0" />
                  <Button fx:id="btnAjouterVoiture" minWidth="-Infinity" styleClass="btn-details" mnemonicParsing="false" text="Ajouter un véhicule" />
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </HBox>
            <ScrollPane fitToWidth="true" prefHeight="500.0" prefWidth="588.0" VBox.vgrow="ALWAYS">
               <content>
                  <FlowPane fx:id="cardsContainer" hgap="15.0" vgap="15.0" />
               </content>
            </ScrollPane>
            <HBox alignment="CENTER" prefHeight="50.0" spacing="12.0">
               <children>
                  <Button fx:id="btnPagePrecedenteCards" mnemonicParsing="false" styleClass="btn-pagination" text="Page précédente" />
                  <Label style="-fx-text-fill: #555; -fx-font-weight: bold;" text="Page" />
                  <Label fx:id="labelNumeroPagesCards" styleClass="badge-pagination" text="1/1" />
                  <Button fx:id="btnPageSuivanteCards" mnemonicParsing="false" styleClass="btn-pagination" text="Page suivante" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <left>
      <VBox prefWidth="220.0" spacing="16.0" styleClass="sidebar-filtres" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="8.0">
               <children>
            <Label styleClass="filter-label" text="Transmission :" />
            <VBox spacing="6.0" styleClass="radio-container">
               <children>
                  <RadioButton fx:id="radioTransmissionToutes" mnemonicParsing="false" text="Toutes" />
                  <RadioButton fx:id="radioTransmissionAuto" mnemonicParsing="false" text="Automatique" />
                  <RadioButton fx:id="radioTransmissionManuelle" mnemonicParsing="false" text="Manuelle" />
               </children>
            </VBox>
               </children>
            </VBox>

            <VBox spacing="6.0">
                    <children>
            <Label styleClass="filter-label" text="Trier par : " />
            <ComboBox fx:id="comboTypeTri" maxWidth="Infinity" />
                    </children>
            </VBox>
               <VBox spacing="6.0">
                  <children>
                  <Label styleClass="filter-label" text="Choisir une marque :" />
                  <ComboBox fx:id="comboMarques" maxWidth="Infinity" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
      </VBox>
   </left>
   <right>
      <fx:include fx:id="detailsVoiture" source="detail.fxml" BorderPane.alignment="CENTER" />
   </right>
   <bottom>
      <fx:include fx:id="zoneFavoris" source="ZoneFavoris.fxml" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
