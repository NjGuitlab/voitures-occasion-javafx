<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="308.0" prefWidth="205.0" spacing="8.0" type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <HBox alignment="CENTER_RIGHT">
      <children>
         <Button fx:id="btnSupprimerVoiture" mnemonicParsing="false" text="X" />
      </children>
   </HBox>
   <HBox alignment="CENTER">
      <children>
          <ImageView fx:id="imageVoiture" fitHeight="97.0" fitWidth="190.0" preserveRatio="true">
            <image>
               <Image url="@/images/images.jpg" />
            </image>
          </ImageView>
      </children>
   </HBox>
   <HBox alignment="CENTER_LEFT" spacing="6.0">
      <children>
         <Label fx:id="labelCardMarque" styleClass="card-title" />
         <Label fx:id="labelCardModele" styleClass="card-title" HBox.hgrow="ALWAYS" />
         <Label fx:id="labelCardAnnee" styleClass="card-year" />
      </children>
   </HBox>
   <HBox spacing="6.0">
      <children>
         <Label styleClass="card-label" text="Kilométrage :" />
         <Label fx:id="labelCardKilometrage" styleClass="card-value" />
      </children>
   </HBox>
   <HBox spacing="6.0">
      <children>
         <Label styleClass="card-label" text="Publié le :" />
         <Label fx:id="labelCardDatePublication" styleClass="card-value" />
      </children>
   </HBox>
   <HBox spacing="6.0">
   <children>
      <Label styleClass="card-label" text="Ville :" />
      <Label fx:id="labelCardVille" styleClass="card-value" />
   </children>
   </HBox>
   <HBox alignment="CENTER_LEFT" spacing="6.0">
      <children>
         <Label styleClass="card-label" text="Prix :" />
         <Label fx:id="labelCardPrix" styleClass="card-price" />
      </children>
   </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
      <children>
         <Button fx:id="btnVoirDetails" minWidth="-Infinity" mnemonicParsing="false" styleClass="btn-details" text="Voir les détails" />
         <Button fx:id="btnModifierVoiture" styleClass="btn-details" minWidth="-Infinity" mnemonicParsing="false" onAction="#ouvrirFormModifierVoiture" text="Modifier" />
      </children>
   </HBox>
</fx:root>
