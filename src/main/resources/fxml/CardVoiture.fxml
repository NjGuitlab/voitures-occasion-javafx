<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="308.0" prefWidth="205.0" spacing="8.0" type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <ImageView fx:id="imageVoiture" fitHeight="97.0" fitWidth="190.0" preserveRatio="true">
      <image>
         <Image url="@/images/images.jpg" />
      </image>
    </ImageView>
   <HBox spacing="4.0" alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
      <children>
         <Label fx:id="labelCardMarque" minWidth="-Infinity" />
         <Label fx:id="labelCardModele"  HBox.hgrow="ALWAYS"/>
         <Label fx:id="labelCardAnnee"  minWidth="-Infinity" />
      </children>
   </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <Label text="Kilométrage :" />
         <Label fx:id="labelCardKilometrage" text="Label" />
      </children>
   </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <Label text="Date de publication :" />
         <Label fx:id="labelCardDatePublication" text="Label" />
      </children>
   </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <Label text="Prix :" />
         <Label fx:id="labelCardPrix" text="Label" />
      </children>
   </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
         <Label text="Ville :" />
         <Label fx:id="labelCardVille" text="Label" />
      </children>
   </HBox>
   <Button fx:id="btnVoirDetails" mnemonicParsing="false" text="Voir les détails" />
</fx:root>
