<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="308.0" prefWidth="205.0" spacing="8.0" type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <ImageView fx:id="imageVoiture" fitHeight="97.0" fitWidth="190.0" preserveRatio="true">
      <image>
         <Image url="@/images/images.jpg" />
      </image>
    </ImageView>
   <HBox spacing="6.0" alignment="CENTER_LEFT">
      <children>
         <Label fx:id="labelCardMarque" styleClass="card-title" />
         <Label fx:id="labelCardModele"  styleClass="card-title" HBox.hgrow="ALWAYS"/>
         <Label fx:id="labelCardAnnee"  styleClass="card-year" />
      </children>
   </HBox>
   <HBox spacing="6.0">
      <children>
         <Label text="Kilométrage :" styleClass="card-label"/>
         <Label fx:id="labelCardKilometrage" styleClass="card-value"/>
      </children>
   </HBox>
   <HBox spacing="6.0">
      <children>
         <Label text="Publié le :" styleClass="card-label"/>
         <Label fx:id="labelCardDatePublication" styleClass="card-value" />
      </children>
   </HBox>
   <HBox spacing="6.0">
   <children>
      <Label text="Ville :" styleClass="card-label"/>
      <Label fx:id="labelCardVille" styleClass="card-value" />
   </children>
   </HBox>
   <HBox alignment="CENTER_LEFT" spacing="6.0">
      <children>
         <Label text="Prix :" styleClass="card-label"/>
         <Label fx:id="labelCardPrix" styleClass="card-price" />
      </children>
   </HBox>
   <Button fx:id="btnVoirDetails" mnemonicParsing="false" text="Voir les détails" styleClass="btn-details" />
</fx:root>
